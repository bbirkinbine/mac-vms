.DS_Store
.claude/

# Local credentials — never commit. Whitelist the .example template only.
.env
.env.*
!.env.*.example

# Packer
packer_cache/
*.box
crash.log
crash.*.log

# Build artifacts
output-*/
*.tart

# Windows runtime state: run-windows COW disk + spawn-windows fleet
# instances. Deliberately OUTSIDE the Packer output_directory so a rebuild
# (or `just clean`, which wipes output-*/) never destroys a running clone.
packer/*/run/

# virtio-win ARM64 driver staging tree, extracted from virtio-win.iso at
# build time by scripts/build-windows.sh. The drivers/ directory itself is
# tracked (with .gitkeep + README.md) so cd_files paths resolve at packer-
# validate time even without a build run.
packer/windows-11-arm64/drivers/staging/

# Real seeds contain SSH pubkeys, passwords, etc. — never commit.
# Whitelist the .example templates only, same pattern as .env.*.
# (YAML is the homelab/cloudbase-init shape; the Windows ARM64 pipeline
# uses JSON — see packer/windows-11-arm64/seed/README.md.)
packer/*/seed/*.yaml
!packer/*/seed/*.example.yaml
packer/*/seed/*.json
!packer/*/seed/*.example.json

# Downloaded installer media — large, redistributable only sometimes (Windows
# ARM64 ISO from Microsoft is bring-your-own; Ubuntu ISO is fine to re-fetch).
*.iso
*.vhdx
*.vhd
